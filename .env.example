# Copy to .env. Used by docker-compose.yml.

# Image tag to run (see GHCR releases once published); "local" for a local build.
IMAGE=ghcr.io/florian-asche/sat-hardware-agent:latest

# Numeric host group IDs that own the device nodes (check with: ls -ln /dev/gpiochip0 /dev/i2c-1 /dev/spidev0.0).
GPIO_GID=997
I2C_GID=998
SPI_GID=999

# 0 = log level from the config file, 1 = INFO, 2 = DEBUG
LOG_VERBOSITY=0
